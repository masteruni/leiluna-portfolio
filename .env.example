# Sending the project brief and the Free Orbit Check (see "Sending the forms" in README.md).
# On Vercel these go in Project → Settings → Environment Variables, not in a file.
# For local testing, copy this file to .env.local and fill in the key.

# Required. An API key from https://resend.com/api-keys. Without it the forms fall back to opening the
# visitor's own email app.
RESEND_API_KEY=

# Optional. The sender, on a domain verified in Resend, e.g. "Leiluna Studio <hello@leilunastudio.com>".
# Left empty, Resend's test sender is used, which only delivers to the address the Resend account was made with.
RESEND_FROM=

# Optional. Where the messages arrive. Left empty, they go to the email in src/content/site.ts.
BRIEF_TO=
